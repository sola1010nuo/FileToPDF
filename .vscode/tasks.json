{
  "version": "2.0.0",
  "tasks": [
    { "label": "build", "type": "process", "command": "dotnet", "args": ["build", "src/FileToPDF"], "problemMatcher": "$msCompile", "group": { "kind": "build", "isDefault": true } },
    { "label": "test", "type": "shell", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test.ps1 -Office", "problemMatcher": "$msCompile" },
